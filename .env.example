# Copy to .env and fill in. Never commit .env.
DISCORD_TOKEN=
ANTHROPIC_API_KEY=
# The bot connects as the app role (subject to row-level security).
DATABASE_URL=postgresql://needtoknow_app:needtoknow_app@localhost:5432/needtoknow
# Migrations run as the schema owner role.
MIGRATION_DATABASE_URL=postgresql://needtoknow_owner:needtoknow_owner@localhost:5432/needtoknow
LOG_LEVEL=INFO
